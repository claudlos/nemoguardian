# Paste your customer API key from /billing/welcome here.
# In self-hosted Docker, this also bootstraps /v1/moderate auth without a pre-seeded DB row.
# Placeholder values like this are rejected; use a real nmg_... key for demos.
NEMOGUARDIAN_API_KEY=nmg_paste_your_key_here
NEMOGUARDIAN_SELF_HOSTED_EMAIL=self-hosted@nemoguardian.local

# Optional — only used if you want to forward usage events back to our billing.
STRIPE_CUSTOMER_ID=

# Optional — enables real Nemotron 3 Ultra triage in deep mode.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
NEMOGUARDIAN_TRIAGE_BASE_URL=
# Wall-clock cap on the deep-mode triage API call (seconds). Local inference
# has no timeout — it runs on your own GPU and cannot hang on the network.
NEMOGUARDIAN_TRIAGE_TIMEOUT_S=30

# HF revisions for the default checkpoints are pinned in code (full commit SHAs)
# for reproducible deploys. Override here, and ALWAYS set the matching revision
# when overriding a NEMOGUARDIAN_*_MODEL — custom models otherwise float on main.
# NEMOGUARDIAN_QWEN_REVISION=
# NEMOGUARDIAN_QWEN_STREAM_REVISION=
# NEMOGUARDIAN_CSR_REVISION=

# Cascade tuning for the Vast.ai RTX 3090 demo.
NEMOGUARDIAN_TIER=self_hosted
NEMOGUARDIAN_QUANTIZE=1
NEMOGUARDIAN_QWEN_MODEL=Qwen/Qwen3Guard-Gen-4B
NEMOGUARDIAN_QWEN_STREAM_MODEL=Qwen/Qwen3Guard-Stream-0.6B
NEMOGUARDIAN_CSR_MODEL=nvidia/Nemotron-Content-Safety-Reasoning-4B
NEMOGUARDIAN_TRIAGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Enable only for a controlled demo host. Keep disabled on internet-facing deployments.
NEMOGUARDIAN_ENABLE_DEMO_ENDPOINT=0

# Comma-separated origins permitted to call the API cross-origin (CORS).
# The /demo console is same-origin so it needs nothing here. Leave unset to deny
# all cross-origin requests. Use "*" only for local development.
# Example: NEMOGUARDIAN_CORS_ORIGINS=https://app.example.com
NEMOGUARDIAN_CORS_ORIGINS=

# Optional local-only escape hatch for unsigned Stripe webhook fixture payloads.
# Never enable on an internet-facing deployment.
NEMOGUARDIAN_INSECURE_WEBHOOK_DEMO=0

# SQLite path for billing/auth data (API-key hashes live here — keep it private).
# Default: ~/.nemoguardian/nemoguardian.db (Docker sets /var/lib/nemoguardian/).
NEMOGUARDIAN_DB_PATH=

# What the cascade returns when EVERY model fails (or none ran): "closed" → unsafe
# (block on total failure, the default), "open" → safe (availability over safety).
# Partial failure always degrades gracefully: surviving models still aggregate.
NEMOGUARDIAN_FAIL_MODE=closed
